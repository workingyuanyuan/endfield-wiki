---
// Override of Starlight's SiteTitle: the site name, a mark that the site is not the
// publisher's, and links to the machine-readable outputs of the current page. Each link
// has a single-key shortcut (M, L, J).
import { LABELS, pageId, localeOf, mdPath, llmsPath, withBase } from '../lib/site.mjs';

const { siteTitle, siteTitleHref, entry } = Astro.locals.starlightRoute;
const locale = localeOf(entry.id);
const t = LABELS[locale.lang];
const links = [
	...(entry.data.lastVerified ? [{ key: 'M', label: 'Markdown', href: withBase(mdPath(pageId(entry.id))) }] : []),
	{ key: 'L', label: 'llms.txt', href: withBase(llmsPath(locale)) },
	{ key: 'J', label: 'index.json', href: withBase('/index.json') },
];
---

<a href={siteTitleHref} class="site-title" translate="no">
	<span class="name">{siteTitle}</span>
	<span class="unofficial">{t.unofficial}</span>
</a>
<nav class="outputs" aria-label={t.formats}>
	{links.map((link) => <a href={link.href} data-key={link.key} aria-keyshortcuts={link.key.toLowerCase()}>{link.label}</a>)}
</nav>

<script is:inline>
	// Single-key shortcuts for the links above. Ignored while typing or with modifier keys.
	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return;
		const target = event.target;
		if (target instanceof HTMLElement) {
			if (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
		}
		if (document.querySelector('dialog[open]')) return;
		const link = document.querySelector(`nav.outputs a[data-key="${event.key.toUpperCase()}"]`);
		if (link instanceof HTMLAnchorElement) link.click();
	});

	// Entrance of section headings, tables and the page notes: each plays once, when it
	// first comes into view (see the motion section of endfield.css). The class on <html>
	// is set here, in the header, before the body is parsed; without this script or
	// without IntersectionObserver nothing is hidden.
	const motion = matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window;
	if (motion) document.documentElement.classList.add('ef-motion');
	document.addEventListener('DOMContentLoaded', () => {
		if (!motion) return;
		const targets = document.querySelectorAll(
			'.sl-markdown-content > .sl-heading-wrapper.level-h2, .sl-markdown-content > table, .sl-markdown-content > .facts',
		);
		let first = true;
		const io = new IntersectionObserver((entries) => {
			let n = 0;
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				const el = entry.target;
				// Blocks on the first screen follow the title in turn; later ones start at once.
				if (first) el.style.setProperty('--ef-delay', `${0.35 + n++ * 0.08}s`);
				el.classList.add('ef-in');
				io.unobserve(el);
			}
			first = false;
		});
		targets.forEach((el) => io.observe(el));
	});
</script>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--ef-display);
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1;
		color: var(--sl-color-white);
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}
	/* A yellow block before the name, as on the labels of the official site. */
	.name::before {
		content: '';
		display: inline-block;
		width: 0.5em;
		height: 0.9em;
		margin-inline-end: 0.45em;
		background: var(--ef-yellow);
		box-shadow: 0 0 0 1px var(--ef-ink);
		vertical-align: -0.08em;
	}
	.unofficial {
		padding: 0.25em 0.5em;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-size: 0.62rem;
		font-weight: 500;
		letter-spacing: 0.08em;
	}
	.outputs {
		display: none;
		gap: 1.1rem;
		margin-inline-start: 1.5rem;
		font-family: var(--ef-display);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.outputs {
			display: flex;
		}
	}
	.outputs a {
		padding: 0.1em 0.3em;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		text-transform: uppercase;
	}
	.outputs a:hover,
	.outputs a:focus-visible {
		background: var(--ef-yellow);
		color: var(--ef-ink);
	}
</style>

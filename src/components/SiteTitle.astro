---
// Override of Starlight's SiteTitle: the site name, a mark that the site is not the
// publisher's, and a link to the first page of each top-level sidebar group (versions,
// operators, systems, AIC), in the sidebar's order and labels. The Markdown twin,
// llms.txt and index.json are linked from the page notes (MarkdownContent.astro).
import { LABELS, pageId, localeOf } from '../lib/site.mjs';

const { siteTitle, siteTitleHref, id: routeId, sidebar } = Astro.locals.starlightRoute;
// The header follows the address: on Starlight's English fallback at a Japanese or Korean
// address it stays Japanese or Korean.
const t = LABELS[localeOf(pageId(routeId)).lang];
const links = (entries) => entries.flatMap((e) => (e.type === 'link' ? [e] : links(e.entries)));
const sections = sidebar
	.filter((entry) => entry.type === 'group')
	.map((group) => {
		const inner = links(group.entries);
		return { label: group.label, href: inner[0]?.href, current: inner.some((e) => e.isCurrent) };
	})
	.filter((s) => s.href);
---

<a href={siteTitleHref} class="site-title" translate="no">
	<svg class="site-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" class="ground" /><path d="M5 8h22L16 27z" class="mark" /><path d="M5 14h22v2.5H5z" class="ground" /></svg>
	<span class="name">{siteTitle}</span>
	<span class="unofficial">{t.unofficial}</span>
</a>
<nav class="sections" aria-label={t.sections}>
	{sections.map((s) => <a href={s.href} aria-current={s.current ? 'true' : undefined}>{s.label}</a>)}
</nav>

<script is:inline>
	// Entrance of section headings, tables and the page notes: each plays once, when it
	// first comes into view (see the motion section of endfield.css). The class on <html>
	// is set here, in the header, before the body is parsed; without this script or
	// without IntersectionObserver nothing is hidden.
	const motion = matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window;
	if (motion) document.documentElement.classList.add('ef-motion');
	document.addEventListener('DOMContentLoaded', () => {
		if (!motion) return;
		const targets = document.querySelectorAll(
			'.sl-markdown-content > .sl-heading-wrapper.level-h2, .sl-markdown-content > table, .sl-markdown-content > .facts',
		);
		let first = true;
		const io = new IntersectionObserver((entries) => {
			let n = 0;
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				const el = entry.target;
				// Blocks on the first screen follow the title in turn; later ones start at once.
				if (first) el.style.setProperty('--ef-delay', `${0.35 + n++ * 0.08}s`);
				el.classList.add('ef-in');
				io.unobserve(el);
			}
			first = false;
		});
		targets.forEach((el) => io.observe(el));
	});
</script>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--ef-display);
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1;
		color: var(--sl-color-white);
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}
	/* The site's icon, the same drawing as public/favicon.svg: a yellow inverted triangle
	   with a cut, on near-black. Inline SVG; check-dist strips svg from the page text. */
	.site-icon {
		flex: none;
		width: 1.35em;
		height: 1.35em;
	}
	.site-icon .ground {
		fill: var(--ef-ink);
	}
	.site-icon .mark {
		fill: var(--ef-yellow);
	}
	.unofficial {
		padding: 0.25em 0.5em;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-size: 0.62rem;
		font-weight: 500;
		letter-spacing: 0.08em;
	}
	.sections {
		display: none;
		gap: 1.4rem;
		margin-inline-start: 1.75rem;
		font-family: var(--ef-display);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.sections {
			display: flex;
		}
	}
	/* Just above 72rem the English links, the search and the buttons fill the one header row;
	   closer spacing keeps the row inside the window. */
	@media (min-width: 72rem) and (max-width: 80rem) {
		.sections {
			gap: 0.9rem;
			margin-inline-start: 1.1rem;
			letter-spacing: 0.03em;
		}
	}
	.sections a {
		padding: 0.15em 0.35em;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		text-transform: uppercase;
	}
	/* The section of the current page, marked as the sidebar marks the current page. */
	.sections a[aria-current] {
		color: var(--sl-color-white);
		box-shadow: inset 0 -2px 0 var(--ef-yellow);
	}
	.sections a:hover,
	.sections a:focus-visible {
		background: var(--ef-yellow);
		color: var(--ef-ink);
	}
</style>
